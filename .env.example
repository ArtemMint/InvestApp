POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=your_db_name_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full SQLAlchemy URL used by the app; docker-compose sets this automatically
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/your_db_name_here
MASSIVE_API_KEY=add_your_massive_api_key_here
FINNHUB_API_KEY=add_your_finnhub_api_key_here
